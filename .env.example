PROXY_TOKEN=replace-with-a-long-random-admin-code
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
HOST=127.0.0.1
PORT=8787
PUBLIC_DAILY_LIMIT=300
ACCOUNT_DAILY_CALL_LIMIT=60
# QUOTA_FILE must be an absolute path in a writable private directory.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-2512
XAI_API_KEY=
# For your DDTokens proxy: XAI_BASE_URL=https://ddtnew.com/v1
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.7
# DDTokens Grok(heavy) approximate billing in RUB: CNY 0.60 / 0.15 cached / 1.80 output per 1M.
# The 11.1 RUB/CNY factor is inferred from the owner's DDTokens logs, NOT an official FX quote.
# Optional override if the proxy's billing conversion changes:
# DDTOKENS_RUB_PER_CNY=11.1
QWEN_API_KEY=
QWEN_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# For DDTokens: GEMINI_BASE_URL=https://ddtnew.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLAUDE_API_KEY=
CLAUDE_MODEL=
# For DDTokens: CLAUDE_BASE_URL=https://ddtnew.com/v1
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Telegram Mini App (optional until a dedicated bot is created)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_APP_URL=https://cityai.site/quorum/
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_STATE_FILE=/var/lib/quorum/telegram-updates.json

# Free task quota. Paid plans and package pricing are not enabled.
# ACCOUNTING_FILE=/var/lib/quorum/accounting.json

# FX rates: Quorum downloads Bank of Russia USD/RUB and CNY/RUB from
# https://www.cbr.ru/scripts/XML_daily.asp (cache 6h; persisted in accounting JSON).
# If the central-bank feed is temporarily inaccessible, previous rate is marked stale.
# All costs and provider price equivalents are displayed in RUB.

# First monetization stage: recurring free tasks; paid plans not enabled yet.
ACCOUNT_MONTHLY_TASKS=10
# Persist remembered logins across deployments; keep this private and backed up.
# SESSION_FILE=/var/lib/quorum/sessions.enc
# Email login with one-time codes, delivered via Resend (verified sender required).
RESEND_API_KEY=
EMAIL_FROM=
# Timeweb SMTP (preferred when fully configured; Resend is optional fallback).
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=businesspulse@cityai.site
SMTP_PASSWORD=
# EMAIL_FROM="Кворум <businesspulse@cityai.site>"
