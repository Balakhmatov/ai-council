[Unit]
Description=Quorum personal AI discussion API
After=network.target
[Service]
Type=simple
WorkingDirectory=/root/ai-council
ExecStart=/root/.nvm/versions/node/v22.21.1/bin/node --env-file=/root/ai-council/.env.private /root/ai-council/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/ai-council/runtime
[Install]
WantedBy=multi-user.target
