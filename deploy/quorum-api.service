[Unit]
Description=Quorum AI Council and Telegram Mini App
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=quorum
Group=quorum
WorkingDirectory=/opt/quorum
EnvironmentFile=/etc/quorum/quorum.env
ExecStart=/usr/bin/node /opt/quorum/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quorum
UMask=0077
[Install]
WantedBy=multi-user.target
